-- ==========================================
-- AUTO HEAD SIPHON LOGIC
-- ==========================================

local AutoHeadSiphonConfig = {
    Enabled = false,
    Delay = 2.0,
}

local headSiphonHooked = false

local function hookHeadSiphonModule()
    if headSiphonHooked then
        return
    end

    if not LocalPlayer or not LocalPlayer:FindFirstChild('PlayerScripts') then
        return
    end

    local success, headSiphonModule = pcall(function()
        return require(LocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.HeadSiphon)
    end)
    if not success or not headSiphonModule then
        return
    end

    if headSiphonModule.startPrompt then
        local originalStartPrompt = headSiphonModule.startPrompt
        headSiphonModule.startPrompt = function(u37)
            local result = originalStartPrompt(u37)
            if AutoHeadSiphonConfig.Enabled and not u37 then -- victim mode
                task.spawn(function()
                    local delayTime = math.clamp(AutoHeadSiphonConfig.Delay or 2, 0.25, 10)
                    task.wait(delayTime)
                    pcall(function()
                        local u21 = game:GetService("ReplicatedStorage").Remotes.AbilityService.ToServer.SiphonEscape
                        u21:FireServer()
                    end)
                end)
            end
            return result
        end
        headSiphonHooked = true
        print('[SCRIPT] Auto Head Siphon hook installed')
    end
end

task.spawn(function()
    while true do
        task.wait(2)
        hookHeadSiphonModule()
        if headSiphonHooked then
            break
        end
    end
end)

-- Disabled Abilities for Silent Aim
local DISABLED_ABILITIES = {
    [AbilityEnums.MuseTeleport] = true,
    [AbilityEnums.PsychicTeleport] = true,
    [AbilityEnums.DarkJosieTeleport] = true,
    [AbilityEnums.VisSeraPortus] = true,
    [AbilityEnums.Siphon] = true,
}

local GAMECOLLISION_ABILITIES = {
    [AbilityEnums.Vido] = true,
    [AbilityEnums.Ictus] = true,
}

local function getCurrentAbilityData()
    local ability = pcall(function() return AbilityClient.getEquippedAbility() end) and AbilityClient.getEquippedAbility() or nil
    if not ability then return nil, nil, 200 end

    local data = AbilityData[ability]
    local baseRange = (data and data.range) or 200

    return ability, data, baseRange
end

local function findClosestEntityToMouse(maxRange)
    local camera = Workspace.CurrentCamera
    local character = LocalPlayer.Character
    if not (character and camera) then return nil end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local entities = Workspace:FindFirstChild("Entities")
    if not entities then return nil end

    local bestEntity = nil
    local bestScore = math.huge

    for _, entity in ipairs(entities:GetChildren()) do
        if entity:IsA("Model") and entity ~= character then
            local humanoid = entity:FindFirstChild("Humanoid")
            local rootPart = entity:FindFirstChild("HumanoidRootPart") or entity.PrimaryPart

            if humanoid and humanoid.Health > 0 and rootPart then
                local distance = (rootPart.Position - root.Position).Magnitude

                if distance <= maxRange then
                    local screenPos, onScreen = camera:WorldToScreenPoint(rootPart.Position)

                    if onScreen then
                        local screenDx = screenPos.X - Mouse.X
                        local screenDy = screenPos.Y - Mouse.Y
                        local screenDist = math.sqrt(screenDx * screenDx + screenDy * screenDy)

                        local score = screenDist * 0.98 + distance * 0.02

                        if score < bestScore then
                            bestScore = score
                            bestEntity = entity
                        end
                    end
                end
            end
        end
    end

    return bestEntity
end

local function isAbilityHitscanRay(params)
    if not params or not params.FilterDescendantsInstances then return false end
    if params.CollisionGroup ~= "RaycastExclusion" then return false end

    local entities = Workspace:FindFirstChild("Entities")
    local localChar = LocalPlayer and LocalPlayer.Character

    if params.FilterType == Enum.RaycastFilterType.Include then
        for _, inst in ipairs(params.FilterDescendantsInstances) do
            if inst == entities or inst.Name == "Entities" then
                return true
            end
        end
        return false
    end

    if params.FilterType == Enum.RaycastFilterType.Exclude then
        for _, inst in ipairs(params.FilterDescendantsInstances) do
            if inst == localChar then
                return true
            end
        end
        return false
    end

    return false
end

-- Hook HitDetection.Hitscan
local originalHitscan
if HitDetection and HitDetection.Hitscan then
    originalHitscan = hookfunction(HitDetection.Hitscan, function(targetInfo)
        if not CombatConfig.SilentAim and not CombatConfig.RangeExpander then
            return originalHitscan(targetInfo)
        end

        local ability, data, baseRange = getCurrentAbilityData()

        if ability and DISABLED_ABILITIES[ability] then
            return originalHitscan(targetInfo)
        end

        local searchRange = CombatConfig.RangeExpander 
            and (baseRange * CombatConfig.RangeMultiplier) 
            or baseRange

        local entity = findClosestEntityToMouse(searchRange)

        if entity then
            local humanoid = entity:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 and entity ~= LocalPlayer.Character then
                return entity
            end
        end

        return originalHitscan(targetInfo)
    end)
end

-- Hook HitDetection.HitscanMobile
local originalHitscanMobile
if HitDetection and HitDetection.HitscanMobile then
    originalHitscanMobile = hookfunction(HitDetection.HitscanMobile, function(targetInfo, target)
        if not CombatConfig.SilentAim and not CombatConfig.RangeExpander then
            return originalHitscanMobile(targetInfo, target)
        end

        local ability, data, baseRange = getCurrentAbilityData()

        if ability and DISABLED_ABILITIES[ability] then
            return originalHitscanMobile(targetInfo, target)
        end

        local searchRange = CombatConfig.RangeExpander
            and (baseRange * CombatConfig.RangeMultiplier)
            or baseRange

        local entity = findClosestEntityToMouse(searchRange)

        if entity then
            local humanoid = entity:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 and entity ~= LocalPlayer.Character then
                return entity
            end
        end

        return originalHitscanMobile(targetInfo, target)
    end)
end

-- Hook GameCollision.Hitscan
local originalGameCollisionHitscan
if GameCollision and GameCollision.Hitscan then
    originalGameCollisionHitscan = hookfunction(GameCollision.Hitscan, function(origin, direction, distance, raycastParams, ...)
        if not CombatConfig.SilentAim and not CombatConfig.RangeExpander then
            return originalGameCollisionHitscan(origin, direction, distance, raycastParams, ...)
        end

        -- Don't modify vertical raycasts (jump/gravity detection)
        if math.abs(direction.Y) > 0.8 then
            return originalGameCollisionHitscan(origin, direction, distance, raycastParams, ...)
        end

        -- Don't modify raycasts from non-ability sources
        local camera = Workspace.CurrentCamera
        if not camera or (origin - camera.CFrame.Position).Magnitude > 25 then
            return originalGameCollisionHitscan(origin, direction, distance, raycastParams, ...)
        end

        -- Don't apply expansion to short raycasts (likely movement/jump related)
        if distance < 15 then
            return originalGameCollisionHitscan(origin, direction, distance, raycastParams, ...)
        end

        local expandedDistance = CombatConfig.RangeExpander
            and (distance * CombatConfig.RangeMultiplier)
            or distance

        local searchRange = expandedDistance
        local entity = findClosestEntityToMouse(searchRange)

        if entity then
            local humanoid = entity:FindFirstChild("Humanoid")
            local targetPart = entity:FindFirstChild("HumanoidRootPart") or entity.PrimaryPart

            if humanoid and humanoid.Health > 0 and targetPart and entity ~= LocalPlayer.Character then
                local fakeResult = {
                    Instance = targetPart,
                    Position = targetPart.Position,
                    Normal = (origin - targetPart.Position).Unit,
                    Distance = (origin - targetPart.Position).Magnitude,
                    Material = Enum.Material.Plastic
                }
                return fakeResult
            end
        end

        return originalGameCollisionHitscan(origin, direction, expandedDistance, raycastParams, ...)
    end)
end

