            print('[SCRIPT] /e help')
            print('[SCRIPT] /e kill [player]')
            print('[SCRIPT] /e teleport [player]')
        end
    end,
})

-- ⚡ CPS BYPASS SYSTEM ⚡
local function runOldCPSBypass()
    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer
    
    if not game:IsLoaded() then
        print("[CPS Bypass] Waiting for game to load...")
        game.Loaded:Wait()
    end
    
    if not lp then
        repeat
            task.wait(0.1)
            lp = Players.LocalPlayer
        until lp
    end
    
    local character = lp.Character or lp.CharacterAdded:Wait()
    if character and not character:FindFirstChild("HumanoidRootPart") then
        character:WaitForChild("HumanoidRootPart", 10)
    end
    
    local playerScripts = lp:WaitForChild("PlayerScripts", 10)
    if not playerScripts then
        lp:Kick("PlayerScripts Load Failed")
        return
    end
    
    task.wait(3)
    
    local modulePath = game:GetService("StarterPlayer")
        :WaitForChild("StarterPlayerScripts")
        :WaitForChild("ModuleScripts")
        :WaitForChild("AutoclickDetection")
    
    local module
    local success = false
    
    for i = 1, 10 do
        success, module = pcall(require, modulePath)
        if success then
            break
        end
        task.wait(1)
    end
    
    if success and module then
        local u18 = debug.getupvalue(module.init, 12)
        if type(u18) == "function" then
            local function myHook()
                print("[CPS Bypass] Successful")
                return nil
            end
            hookfunction(u18, myHook)
            
            local currentUpvalue = debug.getupvalue(module.init, 12)
            if currentUpvalue == myHook or (islclosure and islclosure(currentUpvalue)) then
                print("[CPS Bypass] Hooked")
            else
                lp:Kick("Verification Failed")
            end
        else
            lp:Kick("Index 12 Not Found")
        end
    else
        lp:Kick("Module Load Failed")
    end
end

task.defer(runOldCPSBypass)

-- ⚡ ANTI ANNOY SYSTEM ⚡
--[[
    Standalone Anti Annoy Script

    This script removes or neutralises common camera shake and visual disturbance
    effects from abilities in the game.  It does not depend on any external UI
    libraries and can be executed by itself.  When loaded, it will disable
    camera shake functions and hook into various ability modules to block
    blinding overlays, forced sleep, and other effects that obscure your
    screen.  You can safely require or execute this file without dragging
    in the rest of the TVL mini framework.

    Author: Assistant
--]]

-- Prevent duplicate execution of this script.  If it has already been run
-- in the current environment, subsequent calls return immediately.
if _G.ANTI_ANNOY_LOADED then
    warn('[ANTI ANNOY] Script is already loaded, skipping.')
else
    _G.ANTI_ANNOY_LOADED = true

    -- Grab commonly used services up front.  This reduces repeated lookups
    -- later in the script and makes the code easier to read.
    local AAPlayers = game:GetService('Players')
    local AAReplicatedStorage = game:GetService('ReplicatedStorage')
    local AALocalPlayer = AAPlayers.LocalPlayer

    --[[
        disableAllShakeFunctions

        Iterates through the Lua garbage collector to find any functions or table
        fields responsible for camera shake (e.g. `SmallShake`, `StartShake`,
        `_startCameraShaker`).  Each of these functions is replaced with a no‑op
        so they do nothing when called.  The number of functions disabled is
        printed to the output.  This function runs in a separate task to avoid
        freezing the main thread while scanning the garbage collector.
    ]]
    local function disableAllShakeFunctions()
        -- Run GC scan asynchronously to prevent lag
        task.spawn(function()
            local disabledCount = 0
            local gc = (getgc and getgc(true)) or {}
            local shakeNames = {
                SmallShake = true, StartShake = true, ShakeSustain = true,
                smallShake = true, startShake = true, shakeSustain = true,
                _startCameraShaker = true
            }
            
            local totalItems = #gc
            local batchSize = 100  -- Process in small batches to avoid lag
            
            for i, v in ipairs(gc) do
                -- Yield every batch to prevent frame drops
                if i % batchSize == 0 then
                    task.wait()
                end
                
                if type(v) == 'function' then
                    local ok, info = pcall(debug.getinfo, v)
                    if ok and info and info.name and shakeNames[info.name] then
                        pcall(function()
                            hookfunction(v, function() end)
                            disabledCount = disabledCount + 1
                        end)
                    end
                elseif type(v) == 'table' then
                    pcall(function()
                        if rawget(v, '_startCameraShaker') and type(v._startCameraShaker) == 'function' then
                            v._startCameraShaker = function() end
                            disabledCount = disabledCount + 1
                        end
                    end)
                end
            end
            print('[ANTI ANNOY] Disabled ' .. disabledCount .. ' camera shake function(s) from ' .. totalItems .. ' GC items')
        end)
    end

    --[[
        Ability hook helpers

        Each of the following functions attempts to require the corresponding
        ability module and override one or more of its methods that would
        normally produce a disruptive effect (such as a screen black out or
        blinding overlay).  When successful, the overridden method prints a
        message indicating it has been blocked and then performs no action.

        Each hook returns true on success and false on failure, allowing the
        caller to count how many hooks were applied.
    ]]
    local function hookSolarisImpulsus()
        local success, abilityHandler = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.SolarisImpulsus)
        end)
        if success and abilityHandler then
            abilityHandler.victim = function()
                print('[ANTI ANNOY] Blocked SolarisImpulsus blinding effect')
            end
            return true
        end
        return false
    end

    local function hookPsychicCompulsionSleep()
        local success, sleepModule = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.PsychicCompulsion.Sleep)
        end)
        if success and sleepModule then
            sleepModule.activate = function()
                print('[ANTI ANNOY] Blocked PsychicCompulsion Sleep')
            end
            return true
        end
        return false
    end

    local function hookAdSomnum()
        local success, adSomnumModule = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.AdSomnum)
        end)
        if success and adSomnumModule then
            adSomnumModule.victim = function()
                print('[ANTI ANNOY] Blocked AdSomnum Sleep')
            end
            return true
        end
        return false
    end

    local function hookIllusionAttack()
        local success, illusionModule = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.IllusionAttack)
        end)
        if success and illusionModule then
            illusionModule.punchEffect = function(target)
                local RS = AAReplicatedStorage
                local Debris = game:GetService('Debris')
                local effectTemplate = pcall(function() return RS.Assets.Particles:WaitForChild('CombatHit') end)
                if target and target:FindFirstChild('PrimaryPart') then
                    pcall(function()
                        local SoundManager = require(RS.ModuleScripts.Effects.SoundManager)
                        local AbilityName = require(RS.ModuleScripts.Enums.AbilityName)
                        local AbilityData = require(RS.ModuleScripts.Data.AbilityData)
                        local abilitySounds = AbilityData[AbilityName.IllusionAttack].abilitySounds
                        SoundManager.playLocalSoundOnPart(target.PrimaryPart, abilitySounds.punch)
                    end)
                end
                print('[ANTI ANNOY] Blocked IllusionAttack blackout')
            end
            return true
        end
        return false
    end

    local function hookSol()
        local success, solModule = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.Sol)
        end)
        if success and solModule then
            solModule.victim = function()
                pcall(function()
                    local RS = AAReplicatedStorage
                    local AbilityName = require(RS.ModuleScripts.Enums.AbilityName)
                    local AbilityData = require(RS.ModuleScripts.Data.AbilityData)
                    local animId = AbilityData[AbilityName.Sol].abilityAnimations.victim
                    local anim = Instance.new('Animation')
                    anim.AnimationId = animId
                    if AALocalPlayer.Character then
                        local track = AALocalPlayer.Character.Humanoid.Animator:LoadAnimation(anim)
                        track:Play(0.4)
                    end
                end)
                print('[ANTI ANNOY] Blocked Sol blinding (animation kept)')
            end
            return true
        end
        return false
    end

    local function hookSnapNeck()
        local success, snapNeckModule = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.SnapNeck)
        end)
        if success and snapNeckModule then
            snapNeckModule.begin = function()
                print('[ANTI ANNOY] Blocked SnapNeck blackout')
            end
            snapNeckModule.finish = function() end
            return true
        end
        return false
    end

    local function hookNecksnapLift()
        local success, module = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.NecksnapLift)
        end)
        if success and module then
            module.knockout = function()
                print('[ANTI ANNOY] Blocked NecksnapLift blackout')
            end
            return true
        end
        return false
    end

    local function hookOssox()
        local success, module = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.Ossox)
        end)
        if success and module then
            module.begin = function(caster, victim)
                pcall(function()
                    if victim == AALocalPlayer then
                        local AbilityData = require(AAReplicatedStorage.ModuleScripts.Data.AbilityData)
                        local AbilityName = require(AAReplicatedStorage.ModuleScripts.Enums.AbilityName)
                        local victimAnimId = AbilityData[AbilityName.Ossox].abilityAnimations.victim
                        local anim = Instance.new('Animation')
                        anim.AnimationId = victimAnimId
                        AALocalPlayer.Character.Humanoid.Animator:LoadAnimation(anim):Play()
                    end
                end)
                print('[ANTI ANNOY] Blocked Ossox blackout (animation kept)')
            end
            return true
        end
        return false
    end

    local function hookMenedekQualSurenta()
        local success, module = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.MenedekQualSurenta)
        end)
        if success and module then
            module.begin = function(caster, victim)
                pcall(function()
                    if victim == AALocalPlayer then
                        local AbilityData = require(AAReplicatedStorage.ModuleScripts.Data.AbilityData)
                        local AbilityName = require(AAReplicatedStorage.ModuleScripts.Enums.AbilityName)
                        local animId = AbilityData[AbilityName.MenedekQualSurenta].abilityAnimations.victim
                        local anim = Instance.new('Animation')
                        anim.AnimationId = animId
                        AALocalPlayer.Character.Humanoid.Animator:LoadAnimation(anim):Play()
                    end
                end)
                print('[ANTI ANNOY] Blocked MenedekQualSurenta blackout (animation kept)')
            end
            return true
        end
        return false
    end

    local function hookIncendia()
        local success, incendiaModule = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.Incendia)
        end)
        if success then
            local ppSuccess, ppManager = pcall(function()
                return require(AAReplicatedStorage.ModuleScripts.Effects.PostProcessingEffectsManager)
            end)
            if ppSuccess and ppManager then
                ppManager.sunBurn = function()
                    print('[ANTI ANNOY] Blocked Incendia sunburn overlay')
                end
                return true
            end
        end
        return false
    end

    local function hookSunbeam()
        local success, sunbeamModule = pcall(function()
            return require(AALocalPlayer.PlayerScripts.ModuleScripts.AbilityHandler.Sunbeam)
        end)
        if success and sunbeamModule then
            sunbeamModule.victim = function()
                pcall(function()
                    local AbilityData = require(AAReplicatedStorage.ModuleScripts.Data.AbilityData)
                    local AbilityName = require(AAReplicatedStorage.ModuleScripts.Enums.AbilityName)
                    local victimAnimId = AbilityData[AbilityName.Sol].abilityAnimations.victim
                    local anim = Instance.new('Animation')
                    anim.AnimationId = victimAnimId
                    if AALocalPlayer.Character then
                        local track = AALocalPlayer.Character.Humanoid.Animator:LoadAnimation(anim)
                        track:Play(0.4)
                    end
                end)
                print('[ANTI ANNOY] Blocked Sunbeam yellow screen flash (animation kept)')
            end
            return true
        end
        return false
    end

    --[[
        runAntiAnnoy

        Enables all anti‑annoy measures.  It disables camera shake immediately,
        waits briefly for the player's ModuleScripts to load, then applies each
        ability hook.  The hooks are re‑applied periodically every 30 seconds
        in case the game reloads any modules.  The number of successfully
        applied hooks is printed after each pass.
    ]]
    local function runAntiAnnoy()
        print('[ANTI ANNOY] Initialising...')
        -- Start GC scan asynchronously (non-blocking)
        disableAllShakeFunctions()

        -- Wait for ModuleScripts to exist to prevent require() errors
        if AALocalPlayer and AALocalPlayer.PlayerScripts:FindFirstChild('ModuleScripts') then
            local hookFunctions = {
                {name = 'SolarisImpulsus', func = hookSolarisImpulsus},
                {name = 'PsychicCompulsionSleep', func = hookPsychicCompulsionSleep},
                {name = 'AdSomnum', func = hookAdSomnum},
                {name = 'IllusionAttack', func = hookIllusionAttack},
                {name = 'Sol', func = hookSol},
                {name = 'SnapNeck', func = hookSnapNeck},
                {name = 'NecksnapLift', func = hookNecksnapLift},
                {name = 'Ossox', func = hookOssox},
                {name = 'MenedekQualSurenta', func = hookMenedekQualSurenta},
                {name = 'Incendia', func = hookIncendia},
                {name = 'Sunbeam', func = hookSunbeam}
            }

            -- Function to apply all ability hooks and count successes
            local function applyHooks()
                local count = 0
                for _, hook in ipairs(hookFunctions) do
                    if hook.func() then
                        count = count + 1
                    end
                end
                print('[ANTI ANNOY] Ability hooks applied: ' .. count .. '/11')
                return count
            end

            -- Apply once immediately
            local initialCount = applyHooks()

            -- Only re-apply hooks if not all modules were found initially
            if initialCount < 11 then
                task.spawn(function()
                    while true do
                        task.wait(30)
                        local currentCount = applyHooks()
                        if currentCount >= 11 then
                            print('[ANTI ANNOY] All hooks cached, stopping periodic checks.')
                            break
                        end
                    end
                end)
            end
            print('[ANTI ANNOY] All blockers active.')
        end
    end

    -- Kick off the anti‑annoy functionality automatically on script load
    runAntiAnnoy()
end

-- ⚡ ESP SYSTEM ⚡
local ESPPlayers = game:GetService("Players")
local ESPReplicatedStorage = game:GetService("ReplicatedStorage")
local ESPLocalPlayer = ESPPlayers.LocalPlayer

local ESPSpeciesData = require(ESPReplicatedStorage.ModuleScripts.Data.SpeciesData)

local esp = {}
local stakeESP = {}
local ESPEnabled = true

local toolNames = {
    RedOakStake = "RedOak",
    WhiteOakStake = "WhiteOak",
    QetsiyahCure = "QetCure",
    TheCure = "Cure",
    IndestructibleWhiteOakStake = "Indestructible",
}

local characterNamesCached = {}
local specieTypesCached = {}

local specialCharColors = {
    ["Cleo Sowande"] = Color3.fromRGB(230, 167, 32),
    ["Esther Mikaelson"] = Color3.fromRGB(23, 22, 23),
    ["Qetsiyah"] = Color3.fromRGB(66, 149, 219),
    ["Bonnie Bennett"] = Color3.fromRGB(69, 53, 14),
    ["Dark Josie"] = Color3.fromRGB(224, 39, 171),
    ["Hope Mikaelson"] = Color3.fromRGB(194, 0, 0),
    ["Silas"] = Color3.fromRGB(147, 62, 230),
    ["Davina Claire"] = Color3.fromRGB(67, 222, 33),
    ["Landon Kirby"] = Color3.fromRGB(222, 123, 51),
}

local waitTime = 0.1
local maxWait = 0.5
local waitStep = 0.1

local function createBillboard(adornee)
    local gui = Instance.new("BillboardGui")
    gui.Size = UDim2.new(0, 113, 0, 60)
    gui.Adornee = adornee
    gui.AlwaysOnTop = true
    gui.StudsOffset = Vector3.new(0, 2.5, 0)
    gui.Parent = adornee

    local function makeLabel(name, yScale, font, size, color)
        local lbl = Instance.new("TextLabel")
        lbl.Name = name
        lbl.Size = UDim2.new(1, 0, 0.25, 0)
        lbl.Position = UDim2.new(0, 0, yScale, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextStrokeTransparency = 0.5
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.TextColor3 = color
        lbl.TextSize = size
        lbl.Font = font
        lbl.Parent = gui
        return lbl
    end

    return {
        gui = gui,
        charLabel = makeLabel("CharacterLabel", 0, Enum.Font.GothamMedium, 11, Color3.fromRGB(200, 200, 200)),
        userLabel = makeLabel("UserLabel", 0.25, Enum.Font.GothamMedium, 11, Color3.fromRGB(255, 255, 255)),
        toolLabel = makeLabel("ToolLabel", 0.5, Enum.Font.GothamMedium, 9, Color3.fromRGB(200, 200, 200)),
        distanceLabel = makeLabel("DistanceLabel", 0.75, Enum.Font.GothamMedium, 10, Color3.fromRGB(200, 200, 200)),
    }
end

local function getTools(targetPlayer)
    local bp = targetPlayer:FindFirstChildOfClass("Backpack")
    if not bp then
        return nil
    end
    local tools, seen = {}, {}
    for _, tool in ipairs(bp:GetChildren()) do
        local mapped = toolNames[tool.Name]
        if mapped and not seen[mapped] then
            seen[mapped] = true
            table.insert(tools, mapped)
        end
    end
    return #tools > 0 and table.concat(tools, ", ") or nil
end

local function clearESP(targetPlayer)
    if esp[targetPlayer] and esp[targetPlayer].gui then
        esp[targetPlayer].gui:Destroy()
    end
    esp[targetPlayer] = nil
end

local espConnections = {}

local function setupCharacterESP(targetPlayer)
    if espConnections[targetPlayer] then
        for _, conn in pairs(espConnections[targetPlayer]) do
            if conn then
                conn:Disconnect()
            end
        end
    end
    espConnections[targetPlayer] = {}

    local charAddedConn = targetPlayer.CharacterAdded:Connect(function(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp and ESPEnabled then
            clearESP(targetPlayer)
            esp[targetPlayer] = createBillboard(hrp)
        end
    end)

    table.insert(espConnections[targetPlayer], charAddedConn)
end

local function setUpCached(targetPlayer)
    task.spawn(function()
        if not espConnections[targetPlayer] then
            espConnections[targetPlayer] = {}
        end

        local characterNameChanged
        local specieChanged
        local charAddedConn

        local function handleCharacter(char)
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            if hrp and ESPEnabled then
                clearESP(targetPlayer)

                if specieChanged then
                    specieChanged:Disconnect()
                end
                specieTypesCached[targetPlayer.UserId] = char:GetAttribute("SpecieType") or ""
                specieChanged = char:GetAttributeChangedSignal("SpecieType"):Connect(function()
                    specieTypesCached[targetPlayer.UserId] = char:GetAttribute("SpecieType") or ""
                end)

                characterNamesCached[targetPlayer.UserId] = targetPlayer:GetAttribute("CharacterName") or ""

                esp[targetPlayer] = createBillboard(hrp)
            end
        end

        if targetPlayer.Character then
            handleCharacter(targetPlayer.Character)
        end
        charAddedConn = targetPlayer.CharacterAdded:Connect(handleCharacter)

        table.insert(espConnections[targetPlayer], charAddedConn)

        if characterNameChanged then
            characterNameChanged:Disconnect()
        end
        characterNamesCached[targetPlayer.UserId] = targetPlayer:GetAttribute("CharacterName") or ""
        characterNameChanged = targetPlayer:GetAttributeChangedSignal("CharacterName"):Connect(function()
            characterNamesCached[targetPlayer.UserId] = targetPlayer:GetAttribute("CharacterName") or ""
        end)

        table.insert(espConnections[targetPlayer], characterNameChanged)

        local removedConn = targetPlayer.AncestryChanged:Connect(function(_, parent)
            if not parent then
                characterNamesCached[targetPlayer.UserId] = nil
                specieTypesCached[targetPlayer.UserId] = nil

                if espConnections[targetPlayer] then
                    for _, conn in pairs(espConnections[targetPlayer]) do
                        if conn then
                            conn:Disconnect()
                        end
                    end
                    espConnections[targetPlayer] = nil
                end

                if specieChanged then
                    specieChanged:Disconnect()
                end
            end
        end)

        table.insert(espConnections[targetPlayer], removedConn)
    end)
end

ESPPlayers.PlayerRemoving:Connect(function(leavingPlayer)
    clearESP(leavingPlayer)
    if espConnections[leavingPlayer] then
        for _, conn in pairs(espConnections[leavingPlayer]) do
            if conn then
                conn:Disconnect()
            end
        end
        espConnections[leavingPlayer] = nil
    end
end)

ESPPlayers.PlayerAdded:Connect(function(newPlayer)
    if newPlayer ~= ESPLocalPlayer then
        setupCharacterESP(newPlayer)
        setUpCached(newPlayer)
    end
end)

for _, existingPlayer in ipairs(ESPPlayers:GetPlayers()) do
    if existingPlayer ~= ESPLocalPlayer then
        setupCharacterESP(existingPlayer)
        setUpCached(existingPlayer)
    end
end

local function Color3ToHex(color)
    local r = math.floor(color.R * 255)
    local g = math.floor(color.G * 255)
    local b = math.floor(color.B * 255)
    return string.format("#%02X%02X%02X", r, g, b)
end

task.spawn(function()
    while true do
        task.wait(waitTime)
        if not ESPEnabled then
            continue
        end

        for _, targetPlayer in ipairs(ESPPlayers:GetPlayers()) do
            if targetPlayer == ESPLocalPlayer then
                continue
            end
            local char = targetPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not targetPlayer.Parent or not char or not hrp or not hum or hum.Health <= 0 then
                clearESP(targetPlayer)
                continue
            end

            if not esp[targetPlayer] then
                esp[targetPlayer] = createBillboard(hrp)
            end

            local e = esp[targetPlayer]
            if not e then
                continue
            end

            local charName = characterNamesCached[targetPlayer.UserId] or targetPlayer:GetAttribute("CharacterName")
            local specieType = specieTypesCached[targetPlayer.UserId] or char:GetAttribute("SpecieType")

            e.distanceLabel.Text = string.format(
                "%.1f",
                (
                    hrp.Position
                    - (
                        ESPLocalPlayer.Character
                            and ESPLocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            and ESPLocalPlayer.Character.HumanoidRootPart.Position
                        or Vector3.new(0, 0, 0)
                    )
                ).Magnitude
            )
            e.distanceLabel.Visible = false

            e.charLabel.Visible = charName and charName ~= ""
            if specieType and charName then
                if specieType and not specieTypesCached[targetPlayer.UserId] then
                    specieTypesCached[targetPlayer.UserId] = specieType
                end
                if charName and not characterNamesCached[targetPlayer.UserId] then
                    characterNamesCached[targetPlayer.UserId] = charName
                end

                e.charLabel.Text = charName
                e.charLabel.RichText = true
                e.charLabel.TextColor3 = Color3.fromRGB(150, 150, 150)

                local color
                if specieType and specieType ~= "" and ESPSpeciesData[specieType] then
                    color = ESPSpeciesData[specieType].specieColor
                else
                    color = Color3.fromRGB(255, 255, 255)
                end

                e.charLabel.Text = charName
                    .. " <font color='"
                    .. Color3ToHex(color)
                    .. "'>("
                    .. (specieType or "")
                    .. ")</font>"

                local specialColor = specialCharColors[charName]
                if specialColor then
                    e.charLabel.TextColor3 = specialColor
                end
            end

            e.userLabel.Text = (targetPlayer.DisplayName ~= targetPlayer.Name)
                    and (targetPlayer.DisplayName .. " (" .. targetPlayer.Name .. ")")
                or targetPlayer.Name

            local tools = getTools(targetPlayer)
            e.toolLabel.Visible = tools ~= nil
            if tools then
                e.toolLabel.Text = tools
            end
        end

        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "IndestructibleWhiteOakStake" and not stakeESP[obj] then
                local main = obj:FindFirstChild("Main")
                if main then
                    local gui = Instance.new("BillboardGui")
                    gui.Name = "StakeESP"
                    gui.Size = UDim2.new(0, 120, 0, 25)
                    gui.Adornee = main
                    gui.AlwaysOnTop = true
                    gui.StudsOffset = Vector3.new(0, 3, 0)
                    gui.Parent = main

                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.TextColor3 = Color3.fromRGB(255, 255, 255)
                    label.TextStrokeTransparency = 0.5
                    label.TextStrokeColor3 = Color3.new(0, 0, 0)
                    label.TextSize = 11
                    label.Text = "White Oak Stake"
                    label.Font = Enum.Font.GothamMedium
                    label.Parent = gui

                    stakeESP[obj] = gui
                    obj.AncestryChanged:Connect(function(_, parent)
                        if not parent and stakeESP[obj] then
                            stakeESP[obj]:Destroy()
                            stakeESP[obj] = nil
                        end
                    end)
                end
            end
        end

        if waitTime < maxWait then
            waitTime = math.min(waitTime + waitStep, maxWait)
        end
    end
end)

-- Mark initialization complete
task.defer(function()
    task.wait(0.5)
    _G.__SCRIPT_FULLY_INITIALIZED = true
    print('[SCRIPT] ✅ GUI initialization complete!')
end)
