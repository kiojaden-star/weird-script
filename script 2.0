            local sources = {
                'https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source',
                'https://raw.githubusercontent.com/EdgeIY/infiniteyield/main/source',
                'https://cdn.jsdelivr.net/gh/EdgeIY/infiniteyield@master/source',
            }
            
            local loaded = false
            local lastError = nil
            
            -- Try each source until one works
            for _, sourceUrl in ipairs(sources) do
                local trySuccess, tryErr = pcall(function()
                    local source = game:HttpGet(sourceUrl)
                    if source and source ~= '' then
                        loadstring(source)()
                        loaded = true
                        print('[SCRIPT] Infinite Yield loaded from:', sourceUrl)
                        return true
                    end
                    return false
                end)
                
                if loaded then
                    return true
                end
                
                if tryErr then
                    lastError = tryErr
                end
            end
            
            if not loaded then
                error(lastError or 'All Infinite Yield sources failed')
            end
            
            return true
        end)
        
        if success then
            Fluent:Notify({
                Title = '✅ Infinite Yield Loaded',
